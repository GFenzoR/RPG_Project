# Line endings: a clone on Windows (core.autocrlf=true) must not turn these into CRLF, or
# bash, make, Caddy and the container entrypoints break (docs/13, "Problemas comunes").
* text=auto
*.sh text eol=lf
Makefile text eol=lf
*.mk text eol=lf
Caddyfile* text eol=lf
*.caddy text eol=lf
Dockerfile* text eol=lf
*.dockerignore text eol=lf
*.template text eol=lf
docker-compose*.yml text eol=lf
deploy/dev/initdb/* text eol=lf
deploy/monitoring/** text eol=lf
*.ps1 text eol=crlf
# Binary assets.
*.png binary
*.ogg binary
*.webp binary
*.ico binary
*.icns binary
*.dump binary
