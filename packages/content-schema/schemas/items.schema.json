{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/schemas/items.schema.json",
  "title": "Item list (data/items/*.yaml)",
  "type": "array",
  "items": { "$ref": "#/$defs/item" },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sprite", "name"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "kind": {
          "enum": [
            "ground",
            "wall",
            "decoration",
            "container",
            "weapon",
            "armor",
            "shield",
            "tool",
            "consumable",
            "currency",
            "material",
            "rune",
            "ammo"
          ]
        },
        "sprite": { "$ref": "common.schema.json#/$defs/sprite" },
        "name": { "$ref": "common.schema.json#/$defs/i18nKey" },
        "description": { "$ref": "common.schema.json#/$defs/i18nKey" },
        "weight": { "description": "Grams.", "$ref": "common.schema.json#/$defs/nonNegativeInt" },
        "stackable": { "type": "boolean" },
        "max_stack": { "$ref": "common.schema.json#/$defs/positiveInt" },
        "tradeable": { "type": "boolean" },
        "pickupable": { "type": "boolean" },
        "quest": {
          "type": "boolean",
          "description": "docs/17 UI-6, display only: an item that exists for a quest (what a step's has_item asks for). The client shows its name in the quest colour (--ui-item-quest) with a mark on its card; the server ignores it."
        },
        "retired": {
          "type": "boolean",
          "description": "Lote 11 (docs/06 \"Item\"): an item out of the catalog that stays defined so the characters that own one keep it. make validate refuses every source of it (a shop that sells it, loot, a resource drop, a recipe output, a dialog give_item, a quest reward, a conjuring spell); an NPC may still buy it. The server ignores it."
        },
        "elevation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24,
          "description": "docs/17 ART-8, display only: sprite pixels this map item raises what is stacked on it and the creature standing on its tile (a table or a crate: 8). Raised heights on one tile add up to 24 at most."
        },
        "market_board": {
          "type": "boolean",
          "description": "Using this map item opens the global market (T5.3, docs/02 \"Economía\")."
        },
        "stash": {
          "type": "boolean",
          "description": "Using this map item opens the account stash, shared by every character of the account (docs/02 \"Baúl de la cuenta\")."
        },
        "blocks_movement": {
          "type": "boolean",
          "description": "Blocks walking. Defaults to true for kind: wall, false otherwise (docs/03)."
        },
        "blocks_sight": {
          "type": "boolean",
          "description": "Blocks line of sight and projectiles. Defaults to true for kind: wall, false otherwise (docs/03)."
        },
        "key": {
          "description": "A key (docs/02 \"Puertas con llave\"): the key id of the doors it opens and locks (their door.key). Carried anywhere, never spent.",
          "$ref": "common.schema.json#/$defs/id"
        },
        "door": {
          "type": "object",
          "additionalProperties": false,
          "description": "A door (docs/02 \"Puertas con llave\"): a map item that swaps for its pair when a player next to it uses it. The closed door names the open item it becomes (open) and blocks movement; the open one names the closed item (closed) and does not. key (closed door only) locks it: it opens and locks again only for a player carrying an item with that key id.",
          "properties": {
            "key": { "$ref": "common.schema.json#/$defs/id" },
            "open": { "$ref": "common.schema.json#/$defs/itemRef" },
            "closed": { "$ref": "common.schema.json#/$defs/itemRef" }
          },
          "oneOf": [{ "required": ["open"] }, { "required": ["closed"] }]
        },
        "portal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "description": "The look of a portal of portals.yaml (docs/02 \"Cambiar de piso\", docs/03): the kind it shows and, if given, the way it leads (up or down a floor). The map validator wants such an item on the entrance of every portal (but boat ones), and warns about one where no portal of its kind leaves. The item does not move anyone: portals.yaml does.",
          "properties": {
            "kind": { "enum": ["stairs", "ladder", "hole", "rope_spot", "teleport"] },
            "leads": { "enum": ["up", "down"] }
          }
        },
        "value": {
          "description": "Base price NPCs use as reference.",
          "$ref": "common.schema.json#/$defs/nonNegativeInt"
        },
        "ground": {
          "type": "object",
          "additionalProperties": false,
          "required": ["walkable"],
          "properties": {
            "walkable": { "type": "boolean" },
            "speed": {
              "description": "Terrain cost multiplier in percent (100 = normal).",
              "type": "integer",
              "minimum": 1
            },
            "surface": { "$ref": "common.schema.json#/$defs/surface" },
            "floor": {
              "description": "building = the floor of a room: the map validator wants every side of it closed by a wall or a door (docs/03 \"Pisos de edificio\"). Leave it out for ground that may open outdoors (porch, pier, bridge, stall, ruin).",
              "const": "building"
            }
          }
        },
        "weapon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "attack"],
          "properties": {
            "type": { "enum": ["sword", "axe", "club", "distance", "wand"] },
            "attack": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "defense": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "hands": { "enum": [1, 2] },
            "range": { "$ref": "common.schema.json#/$defs/aimRange" },
            "element": { "$ref": "common.schema.json#/$defs/element" },
            "ammo": {
              "description": "Distance weapons (T3.1): the ammo.type it shoots from the ammo slot, one per shot.",
              "enum": ["arrow", "bolt"]
            }
          }
        },
        "ammo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "attack"],
          "description": "Ammunition (T3.1): adds attack to a distance weapon whose weapon.ammo is type.",
          "properties": {
            "type": { "enum": ["arrow", "bolt"] },
            "attack": { "$ref": "common.schema.json#/$defs/nonNegativeInt" }
          }
        },
        "armor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slot", "armor"],
          "properties": {
            "slot": { "enum": ["head", "body", "legs", "feet", "neck", "ring"] },
            "armor": { "$ref": "common.schema.json#/$defs/nonNegativeInt" }
          }
        },
        "shield": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defense"],
          "properties": { "defense": { "$ref": "common.schema.json#/$defs/nonNegativeInt" } }
        },
        "worn": {
          "description": "How the piece shows on the wearer (docs/06 \"Looks\"): a shape of data/looks.yaml for its slot (weapon, shield, head, torso for body armour, legs, feet) and a tint. Without it the piece is not drawn on the figure (jewellery).",
          "$ref": "common.schema.json#/$defs/wornPiece"
        },
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slots"],
          "properties": { "slots": { "$ref": "common.schema.json#/$defs/positiveInt" } }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["use"],
          "properties": {
            "use": { "enum": ["fishing", "mining", "woodcutting", "smithing", "rope", "shovel"] }
          }
        },
        "consumable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heal_hp": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "heal_mp": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "food_ms": { "$ref": "common.schema.json#/$defs/durationMs" }
          }
        },
        "currency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worth"],
          "properties": {
            "worth": {
              "description": "Value in the smallest coin.",
              "$ref": "common.schema.json#/$defs/positiveInt"
            }
          }
        },
        "rune": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spell", "charges"],
          "description": "A rune casts the effect of spell (no mana, no words) and loses a charge per use (T1.9).",
          "properties": {
            "spell": { "$ref": "common.schema.json#/$defs/spellRef" },
            "charges": { "$ref": "common.schema.json#/$defs/positiveInt" },
            "magic_level": { "$ref": "common.schema.json#/$defs/nonNegativeInt" }
          }
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "skill", "charges", "regen_ms", "chance", "drops"],
          "description": "A gathering spot (T1.12): using a tool with tool.use = tool on the tile tries to harvest it. Each tile runs out after charges successful harvests and refills regen_ms after its last harvest.",
          "properties": {
            "tool": { "enum": ["fishing", "mining", "woodcutting"] },
            "skill": {
              "description": "Skill or craft that sets the success chance and rises with every attempt.",
              "$ref": "common.schema.json#/$defs/skill"
            },
            "reach": {
              "description": "Chebyshev distance (same floor, line of sight) to use the tool from, at most 6 (the half-height of the classic 15x11 window, what a monster notices; the 31x21 view did not stretch it). Default: inventory.reach.",
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "charges": { "$ref": "common.schema.json#/$defs/positiveInt" },
            "regen_ms": { "type": "integer", "minimum": 1 },
            "chance": {
              "type": "object",
              "additionalProperties": false,
              "required": ["base", "per_level", "max"],
              "description": "Success = min(max, base + per_level x (skill level - skill start_level)).",
              "properties": {
                "base": { "$ref": "common.schema.json#/$defs/chance" },
                "per_level": { "type": "number", "minimum": 0, "maximum": 1 },
                "max": { "$ref": "common.schema.json#/$defs/chance" }
              }
            },
            "drops": {
              "type": "array",
              "minItems": 1,
              "description": "On success one drop is picked by weight among those whose min_level the skill reaches.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["item", "weight"],
                "properties": {
                  "item": { "$ref": "common.schema.json#/$defs/itemRef" },
                  "weight": { "$ref": "common.schema.json#/$defs/positiveInt" },
                  "min_level": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
                  "count": {
                    "type": "array",
                    "prefixItems": [
                      { "$ref": "common.schema.json#/$defs/positiveInt" },
                      { "$ref": "common.schema.json#/$defs/positiveInt" }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          }
        },
        "book": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "pages"],
          "description": "A readable book or scroll (docs/02 \"Libros y cofres\"): using it opens the client's reading window with its title and pages, i18n keys (book.<id>.title, book.<id>.page_<n> of i18n/<lang>/books.yaml). The client shows the texts it already has; the server never sends them. Looking at it still gives its description.",
          "properties": {
            "title": { "$ref": "common.schema.json#/$defs/i18nKey" },
            "pages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": { "$ref": "common.schema.json#/$defs/i18nKey" }
            }
          }
        },
        "sigil": {
          "type": "object",
          "additionalProperties": false,
          "description": "A sigil plate of a milestone quest (docs/02 \"Quests de hito\"): the plates of a sigils step are the ones within its radius. With a vocation, only that vocation counts on it. The item needs pickupable: false and must not block movement.",
          "properties": {
            "vocation": { "$ref": "common.schema.json#/$defs/vocationRef" }
          }
        },
        "chest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "rewards"],
          "description": "A reward chest of the map (docs/02 \"Libros y cofres\"): using it gives every reward once per character (storage chest.<id>), or nothing while they do not all fit (capacity and backpack). The id is unique among the chests; each reward an item that exists, is not retired and is not the forge's protection, in a count from 1 to one stack (1 for an item that does not stack). The item needs pickupable: false.",
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/id" },
            "rewards": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["item", "count"],
                "properties": {
                  "item": { "$ref": "common.schema.json#/$defs/itemRef" },
                  "count": { "$ref": "common.schema.json#/$defs/positiveInt" }
                }
              }
            }
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": { "$ref": "common.schema.json#/$defs/positiveInt" },
            "vocations": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "common.schema.json#/$defs/vocationRef" }
            }
          }
        },
        "notes": { "$ref": "common.schema.json#/$defs/notes" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "ground" } } },
          "then": { "required": ["ground"] }
        },
        {
          "if": { "properties": { "kind": { "const": "weapon" } } },
          "then": { "required": ["weapon"] }
        },
        {
          "if": { "properties": { "kind": { "const": "armor" } } },
          "then": { "required": ["armor"] }
        },
        {
          "if": { "properties": { "kind": { "const": "shield" } } },
          "then": { "required": ["shield"] }
        },
        {
          "if": { "properties": { "kind": { "const": "container" } } },
          "then": { "required": ["container"] }
        },
        {
          "if": { "properties": { "kind": { "const": "tool" } } },
          "then": { "required": ["tool"] }
        },
        {
          "if": { "properties": { "kind": { "const": "currency" } } },
          "then": { "required": ["currency"] }
        },
        {
          "if": { "properties": { "kind": { "const": "rune" } } },
          "then": { "required": ["rune"] }
        },
        {
          "if": { "properties": { "kind": { "const": "ammo" } } },
          "then": { "required": ["ammo"] }
        },
        {
          "if": {
            "properties": {
              "weapon": {
                "type": "object",
                "properties": { "type": { "const": "distance" } },
                "required": ["type"]
              }
            },
            "required": ["weapon"]
          },
          "then": {
            "properties": { "weapon": { "type": "object", "required": ["ammo", "range"] } }
          }
        }
      ]
    }
  }
}
