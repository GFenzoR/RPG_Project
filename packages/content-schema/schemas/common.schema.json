{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/schemas/common.schema.json",
  "title": "Shared definitions for content schemas",
  "$defs": {
    "id": {
      "description": "Stable snake_case English identifier.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "i18nKey": {
      "description": "Translation key; must exist in every language under i18n/.",
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$",
      "x-i18n": true
    },
    "sprite": {
      "description": "Sprite path inside assets/sprites, without extension.",
      "type": "string",
      "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*$"
    },
    "notes": { "description": "Internal comment, never shown to players.", "type": "string" },
    "surface": {
      "description": "What a ground is made of, for the living world (livingworld/README.md): footprints, plant and water reactions, step dust and footstep sounds; the server reads it only for trail wear (data/livingworld/wear.yaml).",
      "enum": [
        "sand",
        "wet_sand",
        "snow",
        "mud",
        "grass",
        "tall_grass",
        "dirt",
        "ash",
        "stone",
        "wood",
        "water_shallow",
        "lava"
      ]
    },
    "hexColor": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "wornPiece": {
      "description": "How a piece shows on the engine humanoid (docs/06 \"Looks\"): a shape of data/looks.yaml shapes for its slot and a tint of data/looks.yaml tints.",
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "tint"],
      "properties": {
        "shape": { "$ref": "#/$defs/id" },
        "tint": { "$ref": "#/$defs/id" }
      }
    },
    "wornSet": {
      "description": "What an engine humanoid wears, by slot (shapes and tints of data/looks.yaml).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head": { "$ref": "#/$defs/wornPiece" },
        "torso": { "$ref": "#/$defs/wornPiece" },
        "legs": { "$ref": "#/$defs/wornPiece" },
        "feet": { "$ref": "#/$defs/wornPiece" },
        "shield": { "$ref": "#/$defs/wornPiece" },
        "weapon": { "$ref": "#/$defs/wornPiece" }
      }
    },
    "look": {
      "description": "An engine humanoid (docs/17 \"Humanoides del motor\"): sex, body build, skin, hair style and colour, beard (ids of data/looks.yaml) and, for an NPC or a monster, what it wears.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sex", "body", "skin", "hair", "hair_color", "beard"],
      "properties": {
        "sex": { "$ref": "#/$defs/id" },
        "body": { "$ref": "#/$defs/id" },
        "skin": { "$ref": "#/$defs/id" },
        "hair": { "$ref": "#/$defs/id" },
        "hair_color": { "$ref": "#/$defs/id" },
        "beard": { "$ref": "#/$defs/id" },
        "worn": { "$ref": "#/$defs/wornSet" }
      }
    },
    "itemRef": { "$ref": "#/$defs/id", "x-ref": "item" },
    "monsterRef": { "$ref": "#/$defs/id", "x-ref": "monster" },
    "npcRef": { "$ref": "#/$defs/id", "x-ref": "npc" },
    "questRef": { "$ref": "#/$defs/id", "x-ref": "quest" },
    "vocationRef": { "$ref": "#/$defs/id", "x-ref": "vocation" },
    "spellRef": { "$ref": "#/$defs/id", "x-ref": "spell" },
    "shopRef": { "$ref": "#/$defs/id", "x-ref": "shop" },
    "islandId": { "$ref": "#/$defs/id" },
    "chance": { "type": "number", "minimum": 0, "maximum": 1 },
    "conditionId": {
      "description": "T3.2: a condition of balance.yaml conditions.",
      "enum": [
        "poison",
        "burning",
        "shocked",
        "slowed",
        "hasted",
        "invisible",
        "keen_eye",
        "well_fed"
      ]
    },
    "conditionApply": {
      "description": "T3.2: a condition this source applies. A damage condition takes ticks hits of damage; the others last duration_ms. No chance = always.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/conditionId" },
        "chance": { "$ref": "#/$defs/chance" },
        "ticks": { "$ref": "#/$defs/positiveInt" },
        "damage": { "$ref": "#/$defs/positiveInt" },
        "duration_ms": { "$ref": "#/$defs/durationMs" },
        "range": {
          "description": "Spells only: aims at a monster or, with PvP, a player (by the rules of a direct attack, T5.2) at up to range tiles in line of sight instead of the caster. Only for a harmful condition (kind damage, or speed with a negative speed_pct): the server rejects it on a beneficial one.",
          "$ref": "#/$defs/aimRange"
        }
      },
      "oneOf": [{ "required": ["ticks", "damage"] }, { "required": ["duration_ms"] }]
    },
    "percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "positiveInt": { "type": "integer", "minimum": 1 },
    "aimRange": {
      "description": "Chebyshev tiles (same floor, line of sight) an attack, heal or condition is aimed from, at most 6: the half-height of the classic 15x11 window, what a monster notices (server content.MaxRange). The 31x21 view did not stretch it: a monster hit from that far always fights back.",
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "nonNegativeInt": { "type": "integer", "minimum": 0 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "element": {
      "enum": ["physical", "fire", "ice", "energy", "earth", "holy", "death"]
    },
    "combatSkill": {
      "enum": ["fist", "sword", "axe", "club", "distance", "shield", "magic", "fishing"]
    },
    "craft": {
      "enum": ["mining", "woodcutting", "smithing", "cooking", "alchemy"]
    },
    "skill": {
      "anyOf": [{ "$ref": "#/$defs/combatSkill" }, { "$ref": "#/$defs/craft" }]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "y": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "z": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    },
    "itemCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item"],
      "properties": {
        "item": { "$ref": "#/$defs/itemRef" },
        "count": { "$ref": "#/$defs/positiveInt" }
      }
    },
    "condition": {
      "description": "Dialog/quest condition. Exactly one key per object; use a list for AND.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "level_at_least": { "$ref": "#/$defs/positiveInt" },
        "vocation_in": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/vocationRef" }
        },
        "has_item": { "$ref": "#/$defs/itemCount" },
        "lacks_item": {
          "description": "Holds when the player has fewer than count (default 1) of the item; the opposite of has_item.",
          "$ref": "#/$defs/itemCount"
        },
        "quest_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quest", "state"],
          "properties": {
            "quest": { "$ref": "#/$defs/questRef" },
            "state": {
              "description": "not_started, in_progress and completed are the stored state; available holds while start_quest would start it (never started, or a repeatable quest past its cooldown) and cooling_down while a repeatable quest waits for its cooldown.",
              "enum": ["not_started", "in_progress", "completed", "available", "cooling_down"]
            },
            "step": { "$ref": "#/$defs/id" }
          }
        },
        "quest_not_started": { "$ref": "#/$defs/questRef" },
        "flag_equals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "value"],
          "properties": {
            "key": { "$ref": "#/$defs/id" },
            "value": { "type": "integer" }
          }
        },
        "skill_at_least": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skill", "level"],
          "properties": {
            "skill": { "$ref": "#/$defs/skill" },
            "level": { "$ref": "#/$defs/nonNegativeInt" }
          }
        }
      }
    },
    "conditions": {
      "description": "One condition or a list of conditions (all must hold).",
      "anyOf": [
        { "$ref": "#/$defs/condition" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
      ]
    },
    "action": {
      "description": "Dialog action. 'close' as a bare string, or an object with exactly one key.",
      "anyOf": [
        { "const": "close" },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "give_item": { "$ref": "#/$defs/itemRef" },
            "take_item": { "$ref": "#/$defs/itemCount" },
            "give_xp": { "$ref": "#/$defs/positiveInt" },
            "give_gold": { "$ref": "#/$defs/positiveInt" },
            "take_gold": { "$ref": "#/$defs/positiveInt" },
            "start_quest": { "$ref": "#/$defs/questRef" },
            "set_quest_step": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quest", "step"],
              "properties": {
                "quest": { "$ref": "#/$defs/questRef" },
                "step": { "$ref": "#/$defs/id" }
              }
            },
            "set_flag": { "$ref": "#/$defs/flag" },
            "open_shop": { "$ref": "#/$defs/shopRef" },
            "heal": { "const": true },
            "teleport": { "$ref": "#/$defs/position" },
            "bless": {
              "type": "object",
              "additionalProperties": false,
              "required": ["blessing", "price"],
              "description": "Sells a blessing for price + per_level × the buyer's level (content audit M6); the option text gets the total as {price}.",
              "properties": {
                "blessing": { "$ref": "#/$defs/id" },
                "price": { "$ref": "#/$defs/nonNegativeInt" },
                "per_level": { "$ref": "#/$defs/nonNegativeInt" }
              }
            },
            "train_skill": {
              "description": "Dev-only: raises the skill to level (never down). Only an NPC placed on dev_only islands (the sandbox island) may have it.",
              "type": "object",
              "additionalProperties": false,
              "required": ["skill", "level"],
              "properties": {
                "skill": { "$ref": "#/$defs/skill" },
                "level": { "type": "integer", "minimum": 1, "maximum": 500 }
              }
            },
            "restore_mana": {
              "description": "Dev-only: fills the mana. Only an NPC placed on dev_only islands (the sandbox island) may have it.",
              "const": true
            }
          }
        }
      ]
    },
    "actions": {
      "anyOf": [
        { "$ref": "#/$defs/action" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } }
      ]
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "value": { "type": "integer" }
      }
    }
  }
}
