{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/schemas/livingworld-wind.schema.json",
  "title": "Living world wind (data/livingworld/wind.yaml)",
  "description": "The wind: where it blows, the gusts that cross the map every so often and how each type of plant takes them (livingworld/README.md, Viento). Cosmetic: the server never reads it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["field", "gusts", "kinds"],
  "properties": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "speed"],
      "properties": {
        "direction": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "speed": {
          "description": "How fast a gust front travels, tiles per second.",
          "type": "number",
          "minimum": 0.5,
          "maximum": 40
        },
        "exposure": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/surface" },
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 2 }
        },
        "open": { "type": "number", "minimum": 0, "maximum": 2 },
        "forest": { "type": "number", "minimum": 0, "maximum": 1 },
        "night": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "gusts": {
      "description": "A gust every so often, at random but the same for every client; between two gusts nothing moves. make validate also checks that the numbers leave a real calm.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every_s",
        "jitter",
        "strength",
        "spread",
        "travel_tiles",
        "rise_ms",
        "hold_ms",
        "swings"
      ],
      "properties": {
        "every_s": {
          "description": "One gust per slot of this many seconds: the mean time between two gusts.",
          "type": "number",
          "minimum": 5,
          "maximum": 3600
        },
        "jitter": {
          "description": "Where in its slot a gust starts, share of the slot (0: a metronome).",
          "type": "number",
          "minimum": 0,
          "maximum": 0.95
        },
        "strength": {
          "description": "[weakest, strongest] gust.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0, "maximum": 1.5 }
        },
        "spread": {
          "description": "How far a gust's direction strays from field.direction, degrees either way.",
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "travel_tiles": { "type": "number", "minimum": 8, "maximum": 512 },
        "rise_ms": { "type": "integer", "minimum": 50, "maximum": 5000 },
        "hold_ms": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "swings": { "type": "number", "minimum": 0, "maximum": 6 },
        "drift_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "kinds": {
      "description": "Every plant type has its defaults: a new plant of a type needs no numbers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tree",
        "palm",
        "bush",
        "tall_grass",
        "reed",
        "flower",
        "vine",
        "cactus",
        "dead_tree"
      ],
      "properties": {
        "tree": { "$ref": "#/$defs/kind" },
        "palm": { "$ref": "#/$defs/kind" },
        "bush": { "$ref": "#/$defs/kind" },
        "tall_grass": { "$ref": "#/$defs/kind" },
        "reed": { "$ref": "#/$defs/kind" },
        "flower": { "$ref": "#/$defs/kind" },
        "vine": { "$ref": "#/$defs/kind" },
        "cactus": { "$ref": "#/$defs/kind" },
        "dead_tree": { "$ref": "#/$defs/kind" }
      }
    }
  },
  "$defs": {
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stiffness", "amplitude", "drift", "period_ms", "pivot"],
      "properties": {
        "stiffness": { "type": "number", "minimum": 0, "maximum": 1 },
        "amplitude": {
          "description": "Sprite px at the top in a full gust.",
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "drift": {
          "description": "Sprite px at the top in the calm between gusts, always under one; 0: stock-still.",
          "type": "number",
          "minimum": 0,
          "maximum": 0.95
        },
        "period_ms": { "type": "integer", "minimum": 300, "maximum": 20000 },
        "pivot": {
          "description": "Share of the sprite's height that stays planted when the sprite does not say.",
          "type": "number",
          "minimum": 0,
          "maximum": 0.95
        }
      }
    }
  }
}
