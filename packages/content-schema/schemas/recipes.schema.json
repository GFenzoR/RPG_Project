{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/schemas/recipes.schema.json",
  "title": "Craft recipes (data/recipes.yaml)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "craft", "level", "inputs", "output", "base_success", "xp"],
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "craft": { "$ref": "common.schema.json#/$defs/craft" },
      "station": {
        "description": "Item the player must use (furnace, anvil...).",
        "$ref": "common.schema.json#/$defs/itemRef"
      },
      "level": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
      "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stack" } },
      "output": { "$ref": "#/$defs/stack" },
      "base_success": { "$ref": "common.schema.json#/$defs/chance" },
      "success_per_level": { "$ref": "common.schema.json#/$defs/chance" },
      "xp": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
      "notes": { "$ref": "common.schema.json#/$defs/notes" }
    }
  },
  "$defs": {
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "count"],
      "properties": {
        "item": { "$ref": "common.schema.json#/$defs/itemRef" },
        "count": { "$ref": "common.schema.json#/$defs/positiveInt" }
      }
    }
  }
}
