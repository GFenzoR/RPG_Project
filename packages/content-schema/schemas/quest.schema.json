{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/schemas/quest.schema.json",
  "title": "Quest (data/quests/<id>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "steps"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "$ref": "common.schema.json#/$defs/i18nKey" },
    "chapter": { "$ref": "common.schema.json#/$defs/positiveInt" },
    "min_level": { "$ref": "common.schema.json#/$defs/positiveInt" },
    "repeatable": {
      "description": "A task (docs/06 \"Quest\"): once completed, start_quest takes it again after cooldown_hours (fractions allowed), from the first step, and the rewards are given every time. Dialogs tell its turns apart with quest_state available and cooling_down. No turn may be done with no effort (docs/06 \"Quests repetibles\"): a has_item needs its delivery with take_item, a flag_equals cannot be set by its own rewards, and it cannot start with a dialog_action of, or a reach next to, an NPC that gives it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["cooldown_hours"],
      "properties": {
        "cooldown_hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 8784 }
      }
    },
    "milestone": {
      "description": "A milestone quest (docs/02 \"Quests de hito\"): requires and title are required, it is not repeatable and its last step (only that one) is a sigils step. The quest log lists it, with its requirements, before it is started.",
      "type": "boolean"
    },
    "title": {
      "description": "A milestone's title (i18n key quest.<id>.title): the quest log shows it once the milestone is done.",
      "$ref": "common.schema.json#/$defs/i18nKey"
    },
    "requires": {
      "description": "What a milestone asks of every participant on its plates: a level, optional gear (an item carried, or worn with equipped: true, or a wielded weapon type) and how many players stand on the plates together, optionally one of each listed vocation (as many as players).",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "players"],
      "properties": {
        "level": { "$ref": "common.schema.json#/$defs/positiveInt" },
        "players": { "type": "integer", "minimum": 1, "maximum": 4 },
        "vocations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "common.schema.json#/$defs/vocationRef" }
        },
        "gear": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["item"],
              "properties": {
                "item": { "$ref": "common.schema.json#/$defs/itemRef" },
                "equipped": { "type": "boolean" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["weapon"],
              "properties": {
                "weapon": {
                  "description": "A weapon.type of data/items (items.schema.json): one of them in either hand.",
                  "enum": ["sword", "axe", "club", "distance", "wand"]
                }
              }
            }
          ]
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "complete_when"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "description": { "$ref": "common.schema.json#/$defs/i18nKey" },
          "complete_when": { "$ref": "#/$defs/completion" }
        }
      }
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": false,
        "properties": {
          "xp": { "$ref": "common.schema.json#/$defs/positiveInt" },
          "gold": { "$ref": "common.schema.json#/$defs/positiveInt" },
          "item": { "$ref": "common.schema.json#/$defs/itemRef" },
          "set_flag": { "$ref": "common.schema.json#/$defs/flag" }
        }
      }
    },
    "music": {
      "description": "An important quest's music: its pool (assets/sounds.yaml music.pools) plays while the player stands in one of the rects on one of the floors, over the zone's; a boss in view still beats it. Only the client reads it (client/src/audio/cues.ts questPoolAt).",
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "floors", "rects"],
      "properties": {
        "pool": { "$ref": "common.schema.json#/$defs/id" },
        "floors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 15 }
        },
        "rects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 },
              "w": { "type": "integer", "minimum": 1 },
              "h": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "notes": { "$ref": "common.schema.json#/$defs/notes" }
  },
  "$defs": {
    "completion": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "has_item": { "$ref": "common.schema.json#/$defs/itemCount" },
        "dialog_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["npc", "node"],
          "properties": {
            "npc": { "$ref": "common.schema.json#/$defs/npcRef" },
            "node": { "$ref": "common.schema.json#/$defs/id" }
          }
        },
        "kill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["monster", "count"],
          "properties": {
            "monster": { "$ref": "common.schema.json#/$defs/monsterRef" },
            "count": { "$ref": "common.schema.json#/$defs/positiveInt" }
          }
        },
        "flag_equals": { "$ref": "common.schema.json#/$defs/flag" },
        "sigils": {
          "description": "The cooperative last step of a milestone: the sigil plates (items with a sigil block) within radius (Chebyshev) of x, y on floor z, as many as requires.players, with its vocations. When every plate holds a player meeting the requirements in the same tick, all of them move to `to` (the reward room) and the step completes for each. make validate checks the plates, that they are reached on foot from the temple, and that a player reaches a temple from `to` without keys or tools.",
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z", "radius", "to"],
          "properties": {
            "x": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "y": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "z": { "type": "integer", "minimum": 0, "maximum": 15 },
            "radius": { "type": "integer", "minimum": 0, "maximum": 8 },
            "to": { "$ref": "common.schema.json#/$defs/position" }
          }
        },
        "reach": {
          "description": "Completes while the player stands in a place: a zone of world/islands/*/zones.yaml, or the tiles within radius (Chebyshev, default 0) of x, y on floor z. Checked after every move and relocation (teleport, portal, temple) while the step is current, and when it becomes current. make validate checks the zone exists, or the point lies on an island that is not dev_only on a floor it lists, and that the place has a walkable tile reached on foot from the temple.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["zone"],
              "properties": { "zone": { "$ref": "common.schema.json#/$defs/id" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "z"],
              "properties": {
                "x": { "type": "integer", "minimum": 0, "maximum": 65535 },
                "y": { "type": "integer", "minimum": 0, "maximum": 65535 },
                "z": { "type": "integer", "minimum": 0, "maximum": 15 },
                "radius": { "type": "integer", "minimum": 0, "maximum": 16 }
              }
            }
          ]
        }
      }
    }
  }
}
