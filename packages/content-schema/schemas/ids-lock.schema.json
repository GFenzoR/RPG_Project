{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/schemas/ids-lock.schema.json",
  "title": "Stable numeric IDs (data/ids.lock.yaml, generated by make gen-ids)",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "description": "Item text ID to numeric ID (1..65535). Append-only: never change or reuse a number.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 65535 }
    }
  }
}
