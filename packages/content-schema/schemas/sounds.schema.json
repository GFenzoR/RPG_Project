{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/schemas/sounds.schema.json",
  "title": "Sound manifest (assets/sounds.yaml)",
  "description": "T3.7: sound files and their channel, the game events that play them and the music and ambient loop of each island. make validate also checks that files exist, that a vendor/ file has its CREDITS.md row, that every reference is a declared sound of the right channel and that islands exist in world/world.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "sounds"],
  "properties": {
    "format": { "const": 1 },
    "sounds": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "channel"],
        "properties": {
          "file": {
            "description": "Path under assets/: sounds/... (our own, make sounds, lower case) or vendor/<pack>/... with the pack's own file names (letters, digits, spaces, . _ -; no segment starts with a dot).",
            "type": "string",
            "pattern": "^(sounds/[a-z0-9_/-]+|vendor/[a-z0-9][a-z0-9_-]*/(?:[A-Za-z0-9_ -][A-Za-z0-9._ -]*/)*[A-Za-z0-9_ -][A-Za-z0-9._ -]*)\\.(ogg|opus|mp3|wav)$"
          },
          "channel": { "enum": ["sfx", "ui", "music", "ambient"] },
          "volume": { "type": "number", "minimum": 0, "maximum": 1 },
          "max_voices": { "type": "integer", "minimum": 1, "maximum": 8 }
        }
      }
    },
    "events": {
      "description": "Event name (client/src/audio/cues.ts) → sound id, or ids to pick one at random.",
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$" },
      "additionalProperties": {
        "anyOf": [
          { "$ref": "common.schema.json#/$defs/id" },
          { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/id" } }
        ]
      }
    },
    "music": { "$ref": "#/$defs/loops" },
    "ambient": { "$ref": "#/$defs/loops" }
  },
  "$defs": {
    "loops": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fade_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "islands": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/id" }
        },
        "underground": { "$ref": "common.schema.json#/$defs/id" }
      }
    }
  }
}
