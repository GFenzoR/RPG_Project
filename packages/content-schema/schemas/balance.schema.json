{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/schemas/balance.schema.json",
  "title": "Balance constants (data/balance.yaml)",
  "description": "Every game-rule number lives here; code never hardcodes balance constants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "movement",
    "experience",
    "skills",
    "combat",
    "inventory",
    "gathering",
    "chat",
    "death",
    "economy",
    "party",
    "guild",
    "pvp",
    "travel",
    "reports",
    "idle",
    "antibot"
  ],
  "properties": {
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_step_ms", "diagonal_cost", "max_path_tiles"],
      "properties": {
        "base_step_ms": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "diagonal_cost": {
          "type": "number",
          "minimum": 1
        },
        "max_path_tiles": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curve", "max_level", "pace"],
      "properties": {
        "pace": {
          "description": "Leveling pace target: hours of play to reach each level (a power law between anchors; levels and hours increasing). The bot detection's income floor.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "hours"],
            "properties": {
              "level": { "type": "integer", "minimum": 2 },
              "hours": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "curve": {
          "description": "Total XP for level n: a*n^3 + b*n^2 + c*n + d.",
          "type": "object",
          "additionalProperties": false,
          "required": ["a", "b", "c"],
          "properties": {
            "a": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "b": {
              "type": "number"
            },
            "c": {
              "type": "number"
            },
            "d": {
              "type": "number"
            }
          }
        },
        "max_level": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "shield_max_tries_per_round", "afk"],
      "properties": {
        "base": {
          "description": "Per skill: starting level and tries for the first level-up (tries(n) = base_tries * vocation_factor^(n - start_level)).",
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/skill"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_level", "base_tries"],
            "properties": {
              "start_level": {
                "$ref": "common.schema.json#/$defs/nonNegativeInt"
              },
              "base_tries": {
                "$ref": "common.schema.json#/$defs/positiveInt"
              }
            }
          }
        },
        "shield_max_tries_per_round": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "afk": {
          "description": "Training against a target that does not fight back gives reduced progress after a while.",
          "type": "object",
          "additionalProperties": false,
          "required": ["after_ms", "factor"],
          "properties": {
            "after_ms": {
              "$ref": "common.schema.json#/$defs/durationMs"
            },
            "factor": {
              "$ref": "common.schema.json#/$defs/chance"
            }
          }
        }
      }
    },
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack_interval_ms",
        "fist_attack",
        "skill_attack_divisor",
        "level_divisor",
        "shield_block_divisor",
        "monster_corpse_ms",
        "modes"
      ],
      "properties": {
        "attack_interval_ms": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "fist_attack": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "skill_attack_divisor": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "level_divisor": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "shield_block_divisor": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "monster_corpse_ms": {
          "$ref": "common.schema.json#/$defs/durationMs"
        },
        "wand_min_factor": {
          "description": "A wand hits random(attack × wand_min_factor, attack) of its element (T1.9).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offensive", "balanced", "defensive"],
          "properties": {
            "offensive": {
              "$ref": "#/$defs/mode"
            },
            "balanced": {
              "$ref": "#/$defs/mode"
            },
            "defensive": {
              "$ref": "#/$defs/mode"
            }
          }
        }
      }
    },
    "gathering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_interval_ms", "afk"],
      "description": "Fishing and mining (T1.12).",
      "properties": {
        "use_interval_ms": {
          "description": "Minimum time between two gathering attempts of a player (rate limit).",
          "type": "integer",
          "minimum": 1
        },
        "afk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["after_ms", "factor"],
          "description": "Gathering without leaving the tile for after_ms earns skill tries at factor.",
          "properties": {
            "after_ms": {
              "$ref": "common.schema.json#/$defs/durationMs"
            },
            "factor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "guild": {
      "type": "object",
      "additionalProperties": false,
      "description": "Guilds (T5.1, docs/02 \"Gremios\").",
      "required": [
        "found_cost",
        "found_min_level",
        "max_members",
        "max_vice_leaders",
        "max_invites",
        "invite_hours",
        "name_min",
        "name_max",
        "name_max_words",
        "motd_max",
        "reserved_parts",
        "reserved_words"
      ],
      "properties": {
        "found_cost": {
          "description": "Gold paid (and destroyed) to found a guild.",
          "type": "integer",
          "minimum": 0
        },
        "found_min_level": {
          "description": "Founder's minimum level.",
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "max_members": {
          "description": "Members of a guild, leader included.",
          "type": "integer",
          "minimum": 2,
          "maximum": 500
        },
        "max_vice_leaders": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "max_invites": {
          "description": "Pending invitations of one guild at a time.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "invite_hours": {
          "description": "An invitation expires after this many hours.",
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        },
        "name_min": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "name_max": {
          "description": "At most 32: the guilds.name column.",
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "name_max_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "motd_max": {
          "description": "Characters of the message of the day (at most 255, the chat limit).",
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "reserved_parts": {
          "description": "Lowercase substrings refused anywhere in a name (spaces removed).",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z]{2,}$" }
        },
        "reserved_words": {
          "description": "Lowercase words refused as whole words of a name.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z]{1,}$" }
        }
      }
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_members",
        "invite_ms",
        "update_ms",
        "share_distance",
        "contribution_ms",
        "level_range_pct",
        "level_gap_always",
        "bonus_pct_per_member",
        "max_bonus_pct"
      ],
      "description": "Parties and shared experience (T3.3).",
      "properties": {
        "max_members": {
          "description": "Members of a party, leader included.",
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "invite_ms": {
          "description": "An invitation expires after this many ms.",
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "update_ms": {
          "description": "Members' state refreshes at most this often (ms).",
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "share_distance": {
          "description": "Tiles (Chebyshev, same floor) from the kill within which a member shares.",
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "contribution_ms": {
          "description": "A member shares only if it contributed within this many ms.",
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "level_range_pct": {
          "description": "A member shares only if its level is at least this % of the highest sharing member (anti-carry).",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "level_gap_always": {
          "description": "A member at most this many levels below the highest sharer always qualifies by level.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "bonus_pct_per_member": {
          "description": "Bonus % of the shared pot per sharing member beyond the first.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_bonus_pct": {
          "description": "Cap of the shared bonus %.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_length", "ranges", "flood", "global_interval_ms"],
      "description": "Chat channels, ranges and anti-flood (T1.13).",
      "properties": {
        "max_length": {
          "description": "Characters per message (at most the protocol's 255).",
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "ranges": {
          "type": "object",
          "additionalProperties": false,
          "required": ["whisper", "say", "yell"],
          "description": "Tiles (x and y, same floor) within which players hear each local mode.",
          "properties": {
            "whisper": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": {
                  "$ref": "common.schema.json#/$defs/positiveInt"
                },
                "y": {
                  "$ref": "common.schema.json#/$defs/positiveInt"
                }
              }
            },
            "say": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": {
                  "$ref": "common.schema.json#/$defs/positiveInt"
                },
                "y": {
                  "$ref": "common.schema.json#/$defs/positiveInt"
                }
              }
            },
            "yell": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": {
                  "$ref": "common.schema.json#/$defs/positiveInt"
                },
                "y": {
                  "$ref": "common.schema.json#/$defs/positiveInt"
                }
              }
            }
          }
        },
        "flood": {
          "type": "object",
          "additionalProperties": false,
          "required": ["burst", "refill_ms", "mute_ms"],
          "description": "A bucket of burst messages refilled one every refill_ms; sending with it empty mutes for mute_ms.",
          "properties": {
            "burst": {
              "$ref": "common.schema.json#/$defs/positiveInt"
            },
            "refill_ms": {
              "$ref": "common.schema.json#/$defs/positiveInt"
            },
            "mute_ms": {
              "$ref": "common.schema.json#/$defs/positiveInt"
            }
          }
        },
        "global_interval_ms": {
          "description": "Minimum time between two global-channel messages of a player.",
          "$ref": "common.schema.json#/$defs/durationMs"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_container", "max_open_containers", "use_cooldown_ms", "reach"],
      "properties": {
        "start_container": {
          "description": "Container item equipped in the backpack slot of a character that never played.",
          "$ref": "common.schema.json#/$defs/itemRef"
        },
        "max_open_containers": {
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "use_cooldown_ms": {
          "$ref": "common.schema.json#/$defs/durationMs"
        },
        "reach": {
          "description": "Chebyshev distance (same floor) for actions on ground items.",
          "$ref": "common.schema.json#/$defs/positiveInt"
        }
      }
    },
    "death": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xp_loss_pct",
        "skill_loss_pct",
        "equipment_drop_pct",
        "backpack_drop_pct",
        "max_blessings",
        "xp_loss_pct_all_blessings",
        "novice_max_level",
        "corpse_ms",
        "corpse_owner_only_ms"
      ],
      "properties": {
        "xp_loss_pct": {
          "$ref": "common.schema.json#/$defs/percent"
        },
        "skill_loss_pct": {
          "$ref": "common.schema.json#/$defs/percent"
        },
        "equipment_drop_pct": {
          "$ref": "common.schema.json#/$defs/percent"
        },
        "backpack_drop_pct": {
          "$ref": "common.schema.json#/$defs/percent"
        },
        "max_blessings": {
          "$ref": "common.schema.json#/$defs/nonNegativeInt"
        },
        "xp_loss_pct_all_blessings": {
          "$ref": "common.schema.json#/$defs/percent"
        },
        "novice_max_level": {
          "$ref": "common.schema.json#/$defs/nonNegativeInt"
        },
        "corpse_ms": {
          "$ref": "common.schema.json#/$defs/durationMs"
        },
        "corpse_owner_only_ms": {
          "$ref": "common.schema.json#/$defs/durationMs"
        }
      }
    },
    "economy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coin_ratio", "log", "check_every_ms", "outlier"],
      "properties": {
        "coin_ratio": {
          "description": "Copper per silver and silver per gold.",
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "log": {
          "description": "Economy log batches (T4.1): written outside the tick, at least every flush_ms or every batch_size rows.",
          "type": "object",
          "additionalProperties": false,
          "required": ["flush_ms", "batch_size"],
          "properties": {
            "flush_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
            "batch_size": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        },
        "check_every_ms": {
          "description": "How often each online character's gold and items are reconciled with the log (0 = never).",
          "type": "integer",
          "minimum": 0
        },
        "outlier": {
          "description": "Alert when a character creates more than this per hour of play within a window (gold in copper, items in units).",
          "type": "object",
          "additionalProperties": false,
          "required": ["window_ms", "gold_per_hour", "items_per_hour"],
          "properties": {
            "window_ms": { "type": "integer", "minimum": 60000 },
            "gold_per_hour": { "$ref": "#/$defs/perLevel" },
            "items_per_hour": { "$ref": "#/$defs/perLevel" }
          }
        }
      }
    },
    "reports": {
      "description": "Player reports (T4.1): rate limit per account and the context attached.",
      "type": "object",
      "additionalProperties": false,
      "required": ["burst", "refill_ms", "same_target_ms", "max_reason", "events"],
      "properties": {
        "burst": {
          "description": "Reports in a row per account.",
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "refill_ms": {
          "description": "Then one report every this long.",
          "$ref": "common.schema.json#/$defs/positiveInt"
        },
        "same_target_ms": {
          "description": "The same account reports the same character at most once per this long.",
          "type": "integer",
          "minimum": 0
        },
        "max_reason": {
          "description": "Longest reason, in characters.",
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "events": {
          "description": "Recent events of the reported character attached.",
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      }
    },
    "antibot": {
      "description": "Bot detection (T4.1): behaviour signals 0..1, a score that adds sum(weight × signal) every eval_every_ms and halves every half_life_ms, and graded responses.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eval_every_ms",
        "half_life_ms",
        "pause_ms",
        "signals",
        "thresholds",
        "presence",
        "suspend_ms"
      ],
      "properties": {
        "eval_every_ms": {
          "description": "0 turns the detection off.",
          "type": "integer",
          "minimum": 0
        },
        "half_life_ms": { "type": "integer", "minimum": 60000 },
        "pause_ms": {
          "description": "A gap between actions this long is a pause.",
          "type": "integer",
          "minimum": 1000
        },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["regularity", "reaction", "route", "session", "income"],
          "properties": {
            "regularity": {
              "description": "Time between real actions with too little variation: coefficient of variation cv_low → 1, cv_high → 0, and standard deviation std_ms → 1, twice it → 0 (both must be low).",
              "type": "object",
              "additionalProperties": false,
              "required": ["weight", "min_samples", "cv_low", "cv_high", "std_ms"],
              "properties": {
                "weight": { "$ref": "#/$defs/weight" },
                "min_samples": { "type": "integer", "minimum": 1 },
                "cv_low": { "type": "number", "minimum": 0 },
                "cv_high": { "type": "number", "exclusiveMinimum": 0 },
                "std_ms": { "type": "integer", "minimum": 1 }
              }
            },
            "reaction": {
              "description": "Heals that answer a hit within fast_ms, constantly (standard deviation up to std_ms).",
              "type": "object",
              "additionalProperties": false,
              "required": ["weight", "min_samples", "window_ms", "fast_ms", "std_ms"],
              "properties": {
                "weight": { "$ref": "#/$defs/weight" },
                "min_samples": { "type": "integer", "minimum": 1 },
                "window_ms": { "type": "integer", "minimum": 1 },
                "fast_ms": { "type": "integer", "minimum": 1 },
                "std_ms": { "type": "integer", "minimum": 1 }
              }
            },
            "route": {
              "description": "Share of route segments (segment steps, exact tiles) walked before.",
              "type": "object",
              "additionalProperties": false,
              "required": ["weight", "segment", "min_steps", "repeat_low", "repeat_high"],
              "properties": {
                "weight": { "$ref": "#/$defs/weight" },
                "segment": { "type": "integer", "minimum": 2, "maximum": 32 },
                "min_steps": { "type": "integer", "minimum": 1 },
                "repeat_low": { "type": "number", "minimum": 0, "maximum": 1 },
                "repeat_high": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            "session": {
              "description": "Play without a pause: low_ms → 0, high_ms → 1.",
              "type": "object",
              "additionalProperties": false,
              "required": ["weight", "low_ms", "high_ms"],
              "properties": {
                "weight": { "$ref": "#/$defs/weight" },
                "low_ms": { "type": "integer", "minimum": 0 },
                "high_ms": { "type": "integer", "minimum": 1 }
              }
            },
            "income": {
              "description": "Experience or gold per hour over the median of the online characters of its level band.",
              "type": "object",
              "additionalProperties": false,
              "required": ["weight", "min_peers", "band_levels", "ratio_low", "ratio_high"],
              "properties": {
                "weight": { "$ref": "#/$defs/weight" },
                "min_peers": { "type": "integer", "minimum": 2 },
                "band_levels": { "type": "integer", "minimum": 1 },
                "ratio_low": { "type": "number", "minimum": 1 },
                "ratio_high": { "type": "number", "minimum": 1 }
              }
            }
          }
        },
        "thresholds": {
          "description": "Score of each graded response: log < notify < presence < suspend.",
          "type": "object",
          "additionalProperties": false,
          "required": ["log", "notify", "presence", "suspend"],
          "properties": {
            "log": { "type": "number", "exclusiveMinimum": 0 },
            "notify": { "type": "number", "exclusiveMinimum": 0 },
            "presence": { "type": "number", "exclusiveMinimum": 0 },
            "suspend": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "presence": {
          "description": "In-game presence check: never in combat, on a no-logout tile or idle; a failure adds fail_points but never past suspend by itself; a suspension needs a failed check or one asked confirm_ms ago.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeout_ms",
            "delay_ms",
            "fail_points",
            "confirm_ms",
            "defer_alert_ms",
            "random_per_hour"
          ],
          "properties": {
            "timeout_ms": {
              "description": "Time of active play to answer.",
              "type": "integer",
              "minimum": 60000
            },
            "delay_ms": { "type": "integer", "minimum": 0 },
            "fail_points": { "type": "number", "minimum": 0 },
            "confirm_ms": { "type": "integer", "minimum": 0 },
            "defer_alert_ms": {
              "description": "A due check dodged this long alerts the GMs.",
              "type": "integer",
              "minimum": 60000
            },
            "random_per_hour": {
              "description": "Chance per hour of play of a random check (no effect if failed).",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "suspend_ms": {
          "description": "Length of an automatic suspension (at most 30 days; longer bans are a GM's decision).",
          "type": "integer",
          "minimum": 60000,
          "maximum": 2592000000
        }
      }
    },
    "idle": {
      "description": "Idle disconnect (T4.1): no real action (walk, attack, use, talk) for kick_after_ms; never in combat or on a no-logout tile.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kick_after_ms", "warn_before_ms"],
      "properties": {
        "kick_after_ms": {
          "description": "0 turns it off; otherwise at least 60000.",
          "type": "integer",
          "minimum": 0
        },
        "warn_before_ms": {
          "description": "A system message this long before the disconnect.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "conditions": {
      "description": "Condition rules by id (T3.2). Sources (spells, monster attacks) give the strength and duration.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/conditionId" },
      "additionalProperties": { "$ref": "#/$defs/condition" }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "description": "Global market (T5.3, docs/02 \"Economía\"). Absent or enabled: false turns it off.",
      "required": [
        "enabled",
        "fee_permille",
        "fee_min",
        "fee_max",
        "max_offers",
        "max_amount",
        "max_price",
        "durations_hours",
        "list_size",
        "history_size",
        "reference_days",
        "mailbox_shown",
        "action_burst",
        "action_refill_ms"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "fee_permille": {
          "description": "Posting fee in thousandths of amount x unit price (a gold sink).",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "fee_min": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
        "fee_max": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
        "max_offers": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_amount": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_price": {
          "description": "Copper coins per unit.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "durations_hours": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "integer", "minimum": 1, "maximum": 1440 }
        },
        "list_size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "history_size": { "type": "integer", "minimum": 1, "maximum": 200 },
        "reference_days": { "type": "integer", "minimum": 1, "maximum": 60 },
        "mailbox_shown": { "type": "integer", "minimum": 1, "maximum": 200 },
        "action_burst": { "$ref": "common.schema.json#/$defs/positiveInt" },
        "action_refill_ms": { "type": "integer", "minimum": 1, "maximum": 60000 }
      }
    },
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "description": "Trade window between two adjacent players (T5.3). Absent or enabled: false turns it off.",
      "required": ["enabled", "max_items", "request_ms"],
      "properties": {
        "enabled": { "type": "boolean" },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 32 },
        "request_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 }
      }
    },
    "pvp": {
      "type": "object",
      "additionalProperties": false,
      "description": "Player versus player with skulls and guild wars (T5.2, docs/02 \"PvP\"). enabled: false keeps the game PvE only.",
      "required": [
        "enabled",
        "min_level",
        "damage_pct",
        "aggressor_ms",
        "lock_ms",
        "kill_lock_ms",
        "kill_credit_ms",
        "murderer",
        "outlaw",
        "war"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "min_level": {
          "description": "Below it a character neither attacks players nor is attacked by them.",
          "type": "integer",
          "minimum": 1
        },
        "damage_pct": {
          "description": "Every player-on-player hit is scaled to this percentage.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "aggressor_ms": {
          "description": "The aggressor skull (and the victims' right to defend themselves) lasts this long after the last unjustified attack.",
          "type": "integer",
          "minimum": 1000
        },
        "lock_ms": {
          "description": "After attacking a player: no logout and no protection zone (the victim: no logout).",
          "type": "integer",
          "minimum": 1000
        },
        "kill_lock_ms": {
          "description": "The lock after an unjustified kill (at least lock_ms).",
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "kill_credit_ms": {
          "description": "A death is a kill of every player that hurt the victim this long before it (at most aggressor_ms and lock_ms, so the attacker is still in the world).",
          "type": "integer",
          "minimum": 1000
        },
        "murderer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hours", "windows", "equipment_drop_pct", "backpack_drop_pct"],
          "properties": {
            "hours": {
              "description": "How long the skull lasts after the last unjustified kill.",
              "type": "integer",
              "minimum": 1,
              "maximum": 8760
            },
            "windows": {
              "description": "The skull is reached when any window holds at least its kills.",
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hours", "kills"],
                "properties": {
                  "hours": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1440
                  },
                  "kills": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  }
                }
              }
            },
            "equipment_drop_pct": {
              "description": "Minimum chance of each equipped piece to drop when dying with the skull (blessings do not lower it).",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "backpack_drop_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "description": "The skull of unjustified kills."
        },
        "outlaw": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hours", "windows", "equipment_drop_pct", "backpack_drop_pct"],
          "properties": {
            "hours": {
              "description": "How long the skull lasts after the last unjustified kill.",
              "type": "integer",
              "minimum": 1,
              "maximum": 8760
            },
            "windows": {
              "description": "The skull is reached when any window holds at least its kills.",
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hours", "kills"],
                "properties": {
                  "hours": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1440
                  },
                  "kills": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  }
                }
              }
            },
            "equipment_drop_pct": {
              "description": "Minimum chance of each equipped piece to drop when dying with the skull (blessings do not lower it).",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "backpack_drop_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "description": "The gravest skull, with higher thresholds."
        },
        "war": {
          "type": "object",
          "additionalProperties": false,
          "description": "Guild wars.",
          "required": ["kill_limit", "hours", "answer_hours", "max_wars"],
          "properties": {
            "kill_limit": {
              "description": "The first guild to reach it wins.",
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "hours": {
              "description": "An active war ends after this: more kills wins, or a draw.",
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            },
            "answer_hours": {
              "description": "A declaration nobody answers expires.",
              "type": "integer",
              "minimum": 1,
              "maximum": 336
            },
            "max_wars": {
              "description": "Pending and active wars of one guild.",
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        }
      }
    },
    "travel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combat_block_ms", "arrival_radius"],
      "description": "Boat travel (T3.5).",
      "properties": {
        "combat_block_ms": {
          "description": "A player cannot sail for this long after a monster attacked it, it took damage or it hit a monster.",
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "arrival_radius": {
          "description": "If the arrival tile is taken, the nearest free walkable tile at most this far (Chebyshev).",
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/notes"
    }
  },
  "$defs": {
    "weight": {
      "description": "Points per evaluation at signal 1.",
      "type": "number",
      "minimum": 0
    },
    "perLevel": {
      "description": "Threshold base + per_level × level.",
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "per_level"],
      "properties": {
        "base": { "type": "integer", "minimum": 1 },
        "per_level": { "type": "integer", "minimum": 0 }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stacking"],
      "properties": {
        "kind": { "enum": ["damage", "speed", "skill", "invisible"] },
        "element": { "$ref": "common.schema.json#/$defs/element" },
        "interval_ms": { "type": "integer", "minimum": 50 },
        "max_ticks": { "$ref": "common.schema.json#/$defs/positiveInt" },
        "max_ms": { "type": "integer", "minimum": 50 },
        "speed_pct": { "type": "integer", "exclusiveMinimum": -100, "maximum": 500 },
        "skill": { "enum": ["fist", "sword", "axe", "club", "distance", "shield"] },
        "amount": { "$ref": "common.schema.json#/$defs/positiveInt" },
        "stacking": { "enum": ["refresh", "add"] },
        "cancels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/conditionId" }
        },
        "persists": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "damage" } } },
          "then": { "required": ["element", "interval_ms", "max_ticks"] },
          "else": { "required": ["max_ms"] }
        },
        {
          "if": { "properties": { "kind": { "const": "speed" } } },
          "then": { "required": ["speed_pct"] }
        },
        {
          "if": { "properties": { "kind": { "const": "skill" } } },
          "then": { "required": ["skill", "amount"] }
        }
      ]
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack", "defense"],
      "properties": {
        "attack": {
          "type": "number",
          "minimum": 0
        },
        "defense": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
