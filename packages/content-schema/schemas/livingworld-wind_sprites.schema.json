{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/schemas/livingworld-wind_sprites.schema.json",
  "title": "Wind metadata of the plant sprites (data/livingworld/wind_sprites.yaml)",
  "description": "GENERATED by make spritegen from the recipes' wind metadata and the wind hints of assets/sprites.yaml (livingworld/README.md, Viento). Never edited by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sprites"],
  "properties": {
    "sprites": {
      "description": "By sprite path (the sprite: of data/items).",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/wind" }
    }
  },
  "$defs": {
    "kind": {
      "enum": [
        "tree",
        "palm",
        "bush",
        "tall_grass",
        "reed",
        "flower",
        "vine",
        "cactus",
        "dead_tree"
      ]
    },
    "wind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "pivot": {
          "description": "Where the trunk or stem ends, px over the sprite's bottom edge: nothing moves below it.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "top": {
          "description": "The highest drawn row, px over the bottom edge: the full sway is reached there.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "stiffness": { "type": "number", "minimum": 0, "maximum": 1 },
        "amplitude": { "type": "number", "minimum": 0, "maximum": 4 }
      }
    }
  }
}
