{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/map-schemas/houses.schema.json",
  "title": "Player houses (world/islands/<id>/houses.yaml, T5.4)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "rent", "rects", "doors", "exit"],
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "name": { "$ref": "common.schema.json#/$defs/i18nKey" },
      "rent": {
        "description": "Price of one rent period, in the smallest coin.",
        "type": "integer",
        "minimum": 1,
        "maximum": 4294967295
      },
      "rects": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z", "w", "h"],
          "properties": {
            "x": { "$ref": "common.schema.json#/$defs/coord" },
            "y": { "$ref": "common.schema.json#/$defs/coord" },
            "z": { "$ref": "common.schema.json#/$defs/floor" },
            "w": { "type": "integer", "minimum": 1, "maximum": 255 },
            "h": { "type": "integer", "minimum": 1, "maximum": 255 }
          }
        }
      },
      "doors": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": { "$ref": "common.schema.json#/$defs/position" }
      },
      "exit": { "$ref": "common.schema.json#/$defs/position" },
      "notes": { "$ref": "common.schema.json#/$defs/notes" }
    }
  }
}
