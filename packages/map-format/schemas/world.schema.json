{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/map-schemas/world.schema.json",
  "title": "World index (world/world.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "islands"],
  "properties": {
    "format": {
      "const": 1
    },
    "islands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rect", "level_hint"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "rect": {
            "$ref": "common.schema.json#/$defs/rect"
          },
          "level_hint": {
            "$ref": "common.schema.json#/$defs/levelHint"
          }
        }
      }
    },
    "boat_routes": {
      "description": "Deprecated (T3.5): boat routes live in data/boat_routes.yaml. Kept empty only so the base branch's map-pr check accepts this file; remove in a later PR.",
      "type": "array",
      "maxItems": 0
    }
  }
}
