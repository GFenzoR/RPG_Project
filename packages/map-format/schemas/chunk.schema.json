{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/map-schemas/chunk.schema.json",
  "title": "Map chunk, format 1 (world/islands/*/chunks/zNN/cXXXX_YYYY.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "chunk", "palette", "ground", "items"],
  "properties": {
    "format": { "const": 1 },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cx", "cy", "z"],
      "properties": {
        "cx": { "type": "integer", "minimum": 0, "maximum": 2047 },
        "cy": { "type": "integer", "minimum": 0, "maximum": 2047 },
        "z": { "$ref": "common.schema.json#/$defs/floor" }
      }
    },
    "palette": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "ground": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "array",
        "minItems": 32,
        "maxItems": 32,
        "items": { "type": "integer", "minimum": -1 }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "stack"],
        "properties": {
          "x": { "type": "integer", "minimum": 0, "maximum": 31 },
          "y": { "type": "integer", "minimum": 0, "maximum": 31 },
          "stack": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
