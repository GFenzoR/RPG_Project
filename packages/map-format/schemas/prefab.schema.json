{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpg-project.local/map-schemas/prefab.schema.json",
  "title": "Prefab (world/prefabs/<id>.yaml)",
  "description": "A reusable piece of map for the stamp op. rows is a picture, one character per tile; each character is looked up in legend. A space leaves the tile untouched.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "legend", "rows"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "legend": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["char"],
        "minProperties": 2,
        "properties": {
          "char": { "type": "string", "pattern": "^[!-~]$" },
          "ground": { "$ref": "common.schema.json#/$defs/id" },
          "items": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[ -~]{1,64}$" }
    },
    "notes": { "$ref": "common.schema.json#/$defs/notes" }
  }
}
