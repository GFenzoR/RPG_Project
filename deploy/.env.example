# RPG Project — production stack settings (deploy/docker-compose.yml).
# Copy to deploy/.env (never commit it) and fill in the values. `make docker-up` creates a
# local deploy/.env from this file with SITE_ADDRESS=localhost and a random password.

# ---- images ----------------------------------------------------------------------------
# Published by .github/workflows/images.yml. Tags: latest (last vX.Y.Z), main, sha-<7>,
# X.Y.Z. Pin a release in production; deploy.sh <tag> rewrites this line.
IMAGE_REGISTRY=ghcr.io/gfenzor
IMAGE_TAG=latest

# ---- web / TLS -------------------------------------------------------------------------
# Public hostname (DNS A/AAAA record → this machine). Caddy gets the certificate on its own.
# localhost = Caddy's local CA (testing); :80 = plain HTTP behind a TLS tunnel (docs/13).
SITE_ADDRESS=juego.example.com
# Host ports. Change them only for local tests when 80/443 are taken.
HTTP_PORT=80
HTTPS_PORT=443
# Contact for the certificate authority (expiry warnings).
ACME_EMAIL=

# Session cookie Secure flag. Keep true unless players use plain HTTP on a non-localhost
# host (then browsers would drop the cookie).
COOKIE_SECURE=true

# ---- database --------------------------------------------------------------------------
# Postgres is only reachable inside the Docker network. Use a URL-safe password (it goes
# into DATABASE_URL): openssl rand -hex 24
POSTGRES_USER=rpg
POSTGRES_PASSWORD=
POSTGRES_DB=rpg

# ---- backups (deploy/backup.sh) --------------------------------------------------------
# Dumps live in the `backups` Docker volume (docs/09 explains how to copy them out).
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# Optional off-site copy. Empty = local only. On EC2 prefer an instance role over keys.
BACKUP_S3_URI=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- account emails (T2.1, docs/09 "Emails de la cuenta") ----------------------------------
# Without SMTP_HOST the server sends no email: no verification, no "forgot your password?".
#PUBLIC_URL=https://example.com
#SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#SMTP_PORT=587
#SMTP_SECURITY=starttls
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=RPG Project <noreply@example.com>
#REQUIRE_VERIFIED_EMAIL=false

# ---- login with Google and Discord (T2.1, docs/09 "Login con Google y Discord") -------------
# Redirect URIs: https://<your domain>/api/auth/oauth/google/callback and .../discord/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
