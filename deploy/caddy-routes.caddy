# Routes shared by deploy/Caddyfile (production, TLS) and deploy/Caddyfile.home (behind a
# tunnel, plain HTTP). Imported inside a site block.
#
#   /api/*, /ws, /healthz  → gameserver:8080 (HTTP API, WebSocket, health)
#   /play, /play/*          → the game page of the client build (/srv/client/play/index.html)
#   everything else         → the public website (/srv/client/index.html: landing,
#                             /highscores, /news; T4.3), static files of the build first

encode zstd gzip

# Gameserver: API, health and the game WebSocket. reverse_proxy upgrades WebSockets on its
# own; flush_interval -1 streams frames without buffering.
@backend path /api/* /ws /ws/* /healthz
handle @backend {
	reverse_proxy gameserver:8080 {
		flush_interval -1
		# Long-lived WebSockets must survive a Caddy config reload.
		stream_close_delay 5m
		# The gameserver (-trust-proxy) keys its per-IP rate limits on the LAST
		# X-Forwarded-For entry. Send exactly one: Caddy's {client_ip}, which is the TCP peer
		# unless that peer is in `trusted_proxies` (only the tunnel network in
		# Caddyfile.home; nothing in production). A client-supplied X-Forwarded-For or
		# CF-Connecting-IP is therefore discarded, never appended.
		header_up X-Forwarded-For {client_ip}
		header_up -CF-Connecting-IP
	}
}

# Grafana (T4.4): off by default (404). GRAFANA_PUBLIC=on imports the basic-auth route to
# the monitoring profile's Grafana; anything else fails at start (no such file). The
# gameserver's /metrics, Prometheus and Alertmanager are never routed.
import caddy-grafana-{$GRAFANA_PUBLIC:off}.caddy

# Map editor (docs/04): published in a later phase. Today the editor saves chunks to world/
# through a local development backend (Vite dev server on the contributor's machine), so a
# static build here could not save anything. It arrives with patch submission to review
# (milestone 4-5), which needs accounts and moderation.

# Client build (static Vite build, two pages; T4.3). Hashed assets are immutable; the rest
# (pages, atlas, sounds) is revalidated, so a deploy is picked up on the next page load.
@play path /play /play/*
handle @play {
	root * /srv/client
	header Cache-Control "no-cache"
	# /play has no file: it falls back to the game page, like any path under /play/.
	try_files {path} /play/index.html
	file_server
}

handle {
	root * /srv/client
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@revalidate not path /assets/*
	header @revalidate Cache-Control "no-cache"
	# SPA fallback: /highscores and /news/<slug> are routes of the website page.
	try_files {path} /index.html
	file_server
}

header {
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "DENY"
	-Server
}

log {
	output stdout
	format json
}
