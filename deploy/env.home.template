# RPG Project — settings of the home stack (docs/13-hosting-de-pruebas.md).
#
# `make home-up` copies this file to deploy/.env.home the first time (that copy is ignored
# by git) and fills in every __RANDOM__ with a new random secret. Later runs only add the
# keys that are missing, so an old deploy/.env.home keeps working after a `git pull`.
#
# Everything else has a default in deploy/docker-compose*.yml: uncomment a line only to
# change it, then run `make home-up` again. Full table of variables: docs/13, "Variables".

# ---- secrets (generated; do not share) ---------------------------------------------------
POSTGRES_PASSWORD=__RANDOM__
# Grafana user `admin` (only with `make home-monitoring-up`).
GRAFANA_ADMIN_PASSWORD=__RANDOM__

# ---- required by the production compose file, unused at home ----------------------------
# Caddy listens in plain HTTP at home (deploy/Caddyfile.home); these only satisfy
# deploy/docker-compose.yml.
SITE_ADDRESS=localhost
ACME_EMAIL=home@example.com

# ---- game ---------------------------------------------------------------------------------
# Brand-new accounts may send maps on /maps/submit right away (production waits 24h).
MAP_SUBMIT_MIN_ACCOUNT_AGE=0s
# Session cookie only over HTTPS. Keep `true` for localhost and the tunnels; `false` only
# when friends play over plain http://<LAN or Tailscale IP>:8080.
#COOKIE_SECURE=true

# ---- account emails (T2.1, docs/13 "Emails de la cuenta") -------------------------------------
# Without SMTP_HOST the server sends no email: nobody is asked to confirm it and "forgot
# your password?" is not offered (use `make home-reset-password EMAIL=…` instead).
# Address the links in emails point to. Default http://localhost:8080; set your tunnel's
# fixed domain (https://game.example.com) when friends play through it.
#PUBLIC_URL=
# Real SMTP, e.g. Gmail with an app password: smtp.gmail.com, 587, starttls.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_SECURITY=starttls
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=RPG Project <you@gmail.com>
# Only accounts with a confirmed email may play (needs SMTP).
#REQUIRE_VERIFIED_EMAIL=false
# Trying the flows without a real inbox: Mailpit catches every email at
# http://localhost:8025. Add `mail` to COMPOSE_PROFILES (comma-separated, e.g. map-pr,mail)
# and point SMTP at it:
#COMPOSE_PROFILES=mail
#SMTP_HOST=mailpit
#SMTP_PORT=1025
#SMTP_SECURITY=none
#SMTP_FROM=noreply@rpg.localhost

# ---- login with Google and Discord (T2.1, docs/13 "Login con Google y Discord") ----------------
# Off until you paste the keys of your own apps. Needs PUBLIC_URL to be the fixed address
# players use (localhost or your tunnel's domain; a Quick Tunnel's random URL cannot work).
# Redirect URIs to register: <PUBLIC_URL>/api/auth/oauth/google/callback and .../discord/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=

# ---- where the game listens -----------------------------------------------------------------
# Port on this PC: http://localhost:8080.
#HOME_HTTP_PORT=8080
# 127.0.0.1 = only this PC (tunnels still work). 0.0.0.0 = also your LAN.
#HOME_BIND=127.0.0.1

# ---- tunnels --------------------------------------------------------------------------------
# Token of a named Cloudflare Tunnel (`make home-tunnel-domain`, docs/13 step 4).
#CLOUDFLARE_TUNNEL_TOKEN=
# Network shared by cloudflared and Caddy; change it if it collides with one of yours.
#TUNNEL_SUBNET=172.31.250.0/24

# ---- monitoring (make home-monitoring-up) ---------------------------------------------------
#GRAFANA_PORT=3000
#PROMETHEUS_PORT=9090
#ALERTMANAGER_PORT=9093
# Alert channels (docs/09, "Monitoreo"): Discord or Telegram is the simplest.
#ALERT_DISCORD_WEBHOOK_URL=
#ALERT_TELEGRAM_BOT_TOKEN=
#ALERT_TELEGRAM_CHAT_ID=

# ---- map PR worker (optional, docs/13 "Worker de PR de mapas") ------------------------------
# Turn it on with COMPOSE_PROFILES=map-pr and a bot account's token (never the owner's).
#COMPOSE_PROFILES=map-pr
#GITHUB_MAP_PR_TOKEN=
#MAP_PR_REPOSITORY=GFenzoR/RPG_Project
