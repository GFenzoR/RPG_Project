# syntax=docker/dockerfile:1.7
#
# Web image: Caddy (TLS, reverse proxy to the gameserver) + the static build of the client.
# Build from the repo root:
#
#   docker build -f deploy/Dockerfile.web -t rpg-web .
#
# The client gets its Vite build in T1.5. Until client/package.json has a "build" script the
# image serves deploy/web/placeholder/ instead, so the stack can already be deployed and
# tested end to end (TLS, /api, /ws).

ARG NODE_VERSION=22
ARG CADDY_VERSION=2.11

# ---- client: pnpm workspace build (architecture-independent, runs on the build platform) --
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS client
WORKDIR /src
# corepack installs the pnpm version pinned in package.json ("packageManager").
RUN corepack enable
COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    mkdir -p /out/client \
    && if node -e "process.exit(require('./client/package.json').scripts?.build ? 0 : 1)"; then \
         pnpm install --frozen-lockfile --filter "@rpg/client..." \
         && pnpm --filter @rpg/client run build \
         && cp -R client/dist/. /out/client/; \
       else \
         echo "client has no build script yet (pending T1.5): serving the placeholder page" \
         && cp -R deploy/web/placeholder/. /out/client/; \
       fi

# ---- runtime ------------------------------------------------------------------------------
FROM caddy:${CADDY_VERSION}-alpine
ARG VERSION=dev
ARG COMMIT=unknown
LABEL org.opencontainers.image.title="rpg-project-web" \
      org.opencontainers.image.description="RPG Project web front: Caddy + static client build" \
      org.opencontainers.image.source="https://github.com/GFenzoR/RPG_Project" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=client /out/client/ /srv/client/
# Fails the build on a Caddyfile syntax error. Placeholder values: the real ones come from
# the environment at runtime.
RUN SITE_ADDRESS=localhost ACME_EMAIL=ops@example.com caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
