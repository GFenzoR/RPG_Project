# Home hosting settings (docs/13-hosting-de-pruebas.md). `make home-up` copies this file to
# deploy/.env.home (git-ignored) and fills POSTGRES_PASSWORD with a random value.

POSTGRES_USER=rpg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rpg

# Where Caddy listens on this machine: http://localhost:8080. Use HOME_BIND=0.0.0.0 to open
# it to your LAN, or your Tailscale IP (100.x.y.z) for Tailscale without `tailscale serve`.
HOME_BIND=127.0.0.1
HOME_HTTP_PORT=8080

# Players see HTTPS through the tunnel, so the session cookie stays Secure. Set false only
# when friends connect over plain HTTP (LAN or a Tailscale IP without `tailscale serve`).
COOKIE_SECURE=true

# Network between cloudflared and Caddy; Caddy trusts CF-Connecting-IP only from here.
TUNNEL_SUBNET=172.31.250.0/24
CLOUDFLARED_VERSION=2025.2.0

# Named tunnel with your own domain (optional, `make home-tunnel-domain`).
CLOUDFLARE_TUNNEL_TOKEN=

# Required by the base compose file but unused at home (Caddyfile.home has no TLS/ACME).
SITE_ADDRESS=:80
ACME_EMAIL=unused@example.com

# Images: built from this checkout by `make home-up`. Tags for `docker compose pull`.
IMAGE_TAG=latest
